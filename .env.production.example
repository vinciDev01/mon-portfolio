# Modele du fichier `.env` lu par docker-compose.yml, sur le serveur.
# Copier en `.env` (jamais committe), remplir, puis :  chmod 600 .env

# --- Adresses (sans https://, sans barre finale) ---
DOMAINE_SITE=exemple.dev
DOMAINE_API=api.exemple.dev
DOMAINE_ADMIN=admin.exemple.dev
# https en production. http uniquement pour un essai local (voir la doc).
SCHEMA=https

# --- Secrets ---
# Base de donnees. Hexadecimal : rien a encoder dans l'URL de connexion.
# Generer avec :  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signature des jetons d'administration. Le serveur refuse de demarrer sans.
# Generer avec :  openssl rand -base64 48
JWT_SECRET=

# Compte du backoffice, cree par le seed au premier deploiement.
# Generer un mot de passe avec :  openssl rand -base64 24
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- E-mails de notification (facultatif : sans eux, aucun envoi) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
