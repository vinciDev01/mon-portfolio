# ── Base de donnees ──────────────────────────────────────────────────────────
# Chaine de connexion PostgreSQL. Les caracteres speciaux du mot de passe
# doivent etre encodes en pourcentage (@ devient %40, : devient %3A).
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/portfolio_db?schema=public"

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=4000

# Repertoire de stockage des fichiers televerses, relatif au dossier backend.
UPLOAD_DIR="../uploads"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signature des jetons d'authentification. Le serveur REFUSE de demarrer sans,
# et rejette toute valeur trop courte, trop peu variee ou issue d'un gabarit.
# Generer avec :  openssl rand -base64 48
JWT_SECRET=""

# Identifiants de l'administrateur du backoffice, utilises par `prisma db seed`.
# Le seed echoue s'ils sont absents, plutot que de creer un compte dont le mot
# de passe serait lisible dans le code.
# Generer un mot de passe avec :  openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
