generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id          String   @id @default(uuid())
  faviconPath String?  @map("favicon_path")
  logoPath    String?  @map("logo_path")
  bgColor     String   @default("#131518") @map("bg_color")
  textColor   String   @default("#E4E5E3") @map("text_color")
  fontSize    Int      @default(17) @map("font_size")
  fontFamily  String   @default("IBM Plex Sans") @map("font_family")
  toastMessage String? @map("toast_message")
  toastDelayMs Int     @default(180000) @map("toast_delay_ms")
  cvFilePath  String?  @map("cv_file_path")

  showPresentations  Boolean @default(true) @map("show_presentations")
  showSkills         Boolean @default(true) @map("show_skills")
  showExperiences    Boolean @default(true) @map("show_experiences")
  showCertifications Boolean @default(true) @map("show_certifications")
  showProjects       Boolean @default(true) @map("show_projects")
  showServices       Boolean @default(false) @map("show_services")
  showAbout          Boolean @default(true) @map("show_about")
  showContact        Boolean @default(true) @map("show_contact")
  showTestimonials   Boolean @default(false) @map("show_testimonials")

  allowTestimonialSubmission Boolean @default(true) @map("allow_testimonial_submission")
  defaultLanguage            String  @default("fr") @map("default_language")

  availabilityStatus  String  @default("available") @map("availability_status")
  availabilityLabel   String? @map("availability_label")
  maintenanceMode     Boolean @default(false) @map("maintenance_mode")
  seoTitle            String? @map("seo_title")
  seoDescription      String? @map("seo_description")
  seoImagePath        String? @map("seo_image_path")
  notificationEmail   String? @map("notification_email")

  // Lampe d'atelier
  lampEnabled       Boolean @default(true)  @map("lamp_enabled")
  lampOnByDefault   Boolean @default(false) @map("lamp_on_by_default")
  lampBeamAngle     Int     @default(28)    @map("lamp_beam_angle")
  lampIntensity     Int     @default(70)    @map("lamp_intensity")
  lampDimLevel      Int     @default(40)    @map("lamp_dim_level")

  // Visibilité manquante : StatsSection était rendue sans condition
  showStats         Boolean @default(true)  @map("show_stats")

  // Rythme typographique
  typeScale         String  @default("normal") @map("type_scale")
  lineHeight        Float   @default(1.6)      @map("line_height")
  zigzagAmplitude   Int     @default(50)       @map("zigzag_amplitude")
  sectionSpacing    Int     @default(120)      @map("section_spacing")

  // Mouvement
  animationsEnabled    Boolean @default(true) @map("animations_enabled")
  animationSpeed       Float   @default(1.0)  @map("animation_speed")
  respectReducedMotion Boolean @default(true) @map("respect_reduced_motion")

  // CV genere
  cvFontFamily      String  @default("serif") @map("cv_font_family")
  /**
   * Le CV n'est telechargeable depuis le site que si cette case est cochee.
   * Le format Word est le seul propose publiquement ; le PDF reste reserve a
   * l'administrateur. Faux par defaut : la publication est une decision.
   */
  showCvDownload    Boolean @default(false) @map("show_cv_download")

  // Accent
  accentHue         Int     @default(107) @map("accent_hue")
  accentSaturation  Int     @default(16)  @map("accent_saturation")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  coverImagePath String?   @map("cover_image_path")
  content        String    @db.Text
  excerpt        String?
  isPublished    Boolean   @default(false) @map("is_published")
  publishedAt    DateTime? @map("published_at")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model PersonalInfo {
  id          String   @id @default(uuid())
  name        String   @default("")
  surname     String   @default("")
  email       String   @default("")
  phone       String?
  githubUrl   String?  @map("github_url")
  linkedinUrl String?  @map("linkedin_url")
  avatarPath  String?  @map("avatar_path")
  bio         String?
  nationalite String?
  adresse     String?
  /** L'adresse postale ne part dans le CV public que sur decision explicite. */
  adressePublique Boolean @default(false) @map("adresse_publique")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("personal_info")
}

model Technology {
  id        String   @id @default(uuid())
  label     String
  logoPath  String?  @map("logo_path")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills              Skill[]
  projectTechnologies ProjectTechnology[]

  @@map("technologies")
}

model Organization {
  id         String   @id @default(uuid())
  label      String
  logoPath   String?  @map("logo_path")
  websiteUrl String?  @map("website_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  certifications Certification[]
  services       Service[]

  @@map("organizations")
}

model Presentation {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("presentations")
}

model Skill {
  id           String     @id @default(uuid())
  technologyId String     @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  proficiency  Int?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("skills")
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  role        String
  description String?   @db.Text
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("experiences")
}

model Certification {
  id             String       @id @default(uuid())
  name           String
  imagePath      String?      @map("image_path")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String?      @db.Text
  issueDate      DateTime?    @map("issue_date")
  credentialUrl  String?      @map("credential_url")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("certifications")
}

model Project {
  id             String    @id @default(uuid())
  name           String
  description    String?   @db.Text
  photo1Path     String?   @map("photo1_path")
  photo2Path     String?   @map("photo2_path")
  demoUrl        String?   @map("demo_url")
  targetAudience String?   @map("target_audience")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  technologies  ProjectTechnology[]
  collaborators ProjectCollaborator[]

  @@map("projects")
}

model ProjectCollaborator {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  linkedinUrl String?  @map("linkedin_url")
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project_collaborators")
}

model ProjectTechnology {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String     @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
  @@map("project_technologies")
}

model Service {
  id             String        @id @default(uuid())
  label          String
  description    String?       @db.Text
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("services")
}

model About {
  id        String   @id @default(uuid())
  content   String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("about")
}

model ContactMessage {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

model Testimonial {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  company    String?
  role       String?
  content    String   @db.Text
  isApproved Boolean  @default(false) @map("is_approved")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

/**
 * Section libre du CV genere.
 *
 * Les sections issues de la base (presentation, technologies, certifications,
 * experiences, projets) portent un rang implicite de 10 a 60 ; celles-ci
 * s'intercalent par leur `sortOrder`. Une section a 20 tombe donc entre la
 * presentation et les technologies.
 */
model CvSection {
  id        String   @id @default(uuid())
  titre     String
  /** Une entree par ligne. */
  lignes    String
  /** Fausse pour tout ce qui ne doit pas partir dans le CV telechargeable. */
  publique  Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cv_sections")
}
